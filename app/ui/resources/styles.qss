/* CCC Live Studio - 全局样式

   强制浅色主题: 显式给每类控件设 背景+前景, 不依赖系统调色板.
   (否则 Windows 深色模式下未设样式的控件会"深底浅字", 与强制的浅底冲突 → 看不见) */

/* ---- 基线: 所有控件浅底深字 + 全局基准字号 (后面更具体规则按需覆盖) ---- */
QWidget {
    background-color: #f5f5f7;
    color: #1f2937;
    font-size: 15px;
}

QMainWindow {
    background-color: #f5f5f7;
}

/* ---- 顶部菜单栏 (深色, 比 QWidget 更具体, 不受基线影响) ---- */
QMenuBar {
    background-color: #1f2937;
    color: #e5e7eb;
    border: none;
    padding: 4px 6px;
    font-size: 16px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 14px;
    border-radius: 4px;
}

QMenuBar::item:selected {   /* 悬停 / 打开中的顶层菜单 */
    background-color: #374151;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #2563eb;
    color: #ffffff;
}

/* 下拉的菜单面板 (浅底, 与内容区一致) */
QMenu {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    padding: 4px;
}

QMenu::item {
    padding: 8px 26px 8px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2563eb;
    color: #ffffff;
}

QMenu::item:checked {
    font-weight: 600;
    color: #2563eb;
}

QMenu::item:selected:checked {
    color: #ffffff;
}

QMenu::item:disabled {
    color: #9ca3af;
}

QMenu::separator {
    height: 1px;
    background: #e5e7eb;
    margin: 4px 8px;
}

/* ---- 状态栏 ---- */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #d1d5db;
    color: #4b5563;
    font-size: 14px;
}

QStatusBar QLabel {
    padding: 0 8px;
}

/* ---- 标题 / 提示文字 ---- */
QLabel#pageTitle {
    font-size: 27px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 8px;
}

QLabel#pageHint {
    color: #6b7280;
    font-size: 15px;
}

/* ---- 文本输入类 ---- */
QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QDateEdit, QDateTimeEdit, QSpinBox {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QComboBox:focus, QDateEdit:focus, QDateTimeEdit:focus {
    border: 1px solid #2563eb;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled,
QDateEdit:disabled, QDateTimeEdit:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
}

/* drop-down 只是留出点击区; 箭头必须自己画 ——
 * 同 ::indicator 的道理: 样式表接管后 Qt 不再画原生箭头, 不给 ::down-arrow
 * 配图的话下拉框看起来就跟单行输入框一模一样 (2026-08 修)。 */
QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: url({RES}/chevron.png);
    width: 10px;
    height: 10px;
}

QComboBox::down-arrow:disabled {
    image: url({RES}/chevron-disabled.png);
}

/* 下拉弹出列表 */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    outline: none;
}

/* 日期选择器弹出的日历 */
QCalendarWidget QWidget {
    background-color: #ffffff;
    color: #1f2937;
}
QCalendarWidget QAbstractItemView {
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

/* ---- 按钮 ---- */
QPushButton {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #f3f4f6;
}

QPushButton:pressed {
    background-color: #e5e7eb;
}

QPushButton:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border-color: #e5e7eb;
}

QPushButton#primaryButton {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #1d4ed8;
}

QPushButton#primaryButton:pressed {
    background-color: #1e40af;
}

QPushButton#primaryButton:disabled {
    background-color: #93c5fd;
    color: #eff6ff;
}

/* ---- 单选 / 复选 ----
 * 指示器必须显式写全: 一旦 QSS 命中 QCheckBox/QRadioButton, Qt 就从原生
 * Win11 绘制切到样式表绘制, 没写 ::indicator 的话勾选态只画一个光秃秃的
 * ✓、连方框都没有 (2026-08 用户反馈"看不出是 checkbox")。
 * {RES} 由 main_window._apply_stylesheet 换成 resources 目录绝对路径 ——
 * QSS 里的相对 url() 是相对进程工作目录解析的, 打包后必然失效。 */
QRadioButton, QCheckBox {
    color: #1f2937;
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #9ca3af;
    background-color: #ffffff;
}

QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 9px; }

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #2563eb;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
    image: url({RES}/check.png);
}

QRadioButton::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
    image: url({RES}/radio-dot.png);
}

/* 禁用态: 灰掉但仍看得出勾没勾 (润稿关掉时整块会禁用) */
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: #d1d5db;
    background-color: #f3f4f6;
}

QCheckBox::indicator:checked:disabled {
    background-color: #9ca3af;
    border-color: #9ca3af;
}

QRadioButton::indicator:checked:disabled {
    background-color: #9ca3af;
    border-color: #9ca3af;
}

/* ---- 分组框 ---- */
QGroupBox {
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
}

/* ---- 进度条 (下载队列) ---- */
QProgressBar {
    border: 1px solid #d1d5db;
    border-radius: 4px;
    background-color: #ffffff;
    text-align: center;
    color: #1f2937;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 3px;
}

/* ---- 滚动区: 透明, 跟随页面背景 ---- */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* ---- 弹窗 (QMessageBox / QInputDialog): 大气一点 ---- */
QMessageBox, QInputDialog {
    background-color: #ffffff;
}

QMessageBox QLabel, QInputDialog QLabel {
    color: #1f2937;
    font-size: 16px;
    min-width: 340px;
    padding: 6px 10px;
}

QMessageBox QPushButton, QInputDialog QPushButton {
    min-width: 100px;
    min-height: 36px;
    padding: 8px 26px;
    font-size: 15px;
}
